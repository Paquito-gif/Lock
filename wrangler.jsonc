// Cloudflare Worker for the Elysian Pyre website (https://lock.paquito-dev.workers.dev)
// Deploy: npx wrangler deploy
{
  "name": "lock",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CONFIG", "id": "cf5874016f9f412db862b13fbc698f6d" }
  ],
  "vars": {
    // the only wallet allowed to publish the contract address on the site (empty: publishing is off)
    "ADMIN": ""
  },
  "observability": { "enabled": true }
}
